# LLM API Keys
LITELLM_API_KEY=your-litellm_api_key
LITELLM_BASE_URL=your-litellm_base_url

# Google Cloud / GA4
# Path to your Google Cloud service account credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS=your-google_application_credentials
# FALLBACK: Gemini Direct (Always recommended to have)
# =your-#
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini_api_key
LLM_FALLBACK_MODEL=your-llm_fallback_model
# Google Sheets (Screaming Frog SEO data)
SCREAMING_FROG_SHEET_ID=your-screaming_frog_sheet_id
# Optional: specific sheet name/tab within the spreadsheet

# Server Configuration
PORT=your-port
HOST=your-host
LOG_LEVEL=your-log_level

# Optional: LLM Configuration
LLM_MODEL=your-llm_model
LLM_TEMPERATURE=your-llm_temperature
LLM_MAX_TOKENS=your-llm_max_tokens
LLM_TIMEOUT=your-llm_timeout

# Optional: API Configuration
GA4_API_TIMEOUT=your-ga4_api_timeout
SHEETS_API_TIMEOUT=your-sheets_api_timeout

# G4A_MEASUREMENT_ID=your-# g4a_measurement_id
# G4A_API_SECRET=your-# g4a_api_secret